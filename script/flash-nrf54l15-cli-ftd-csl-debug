# Flash ot-cli-ftd built by script/build-nrf54l15-cli-ftd-csl onto a connected nRF54L15 DK.
#
# Usage:
#   ./script/flash-nrf54l15-cli-ftd-csl-debug
#   ./script/flash-nrf54l15-cli-ftd-csl-debug <serial-number>
#   ./script/flash-nrf54l15-cli-ftd-csl-debug /path/to/ot-cli-ftd[.hex|.elf]
#
# Environment:
#   OT_CMAKE_BUILD_DIR     Build tree (default: build-nrf54l15-cli-ftd-csl-debug)
#   NRFUTIL_SERIAL_NUMBER  J-Link serial (default: nRF54L15 DK / PCA10156 via nrfutil)
#   NRFUTIL_PROGRAM_OPTIONS  Default: chip_erase_mode=ERASE_ALL,reset=RESET_SYSTEM
#   OBJCOPY                arm-none-eabi-objcopy (default: on PATH)

set -euo pipefail

OT_SRCDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
readonly OT_SRCDIR

OT_CMAKE_BUILD_DIR="${OT_CMAKE_BUILD_DIR:-build-nrf54l15-cli-ftd-csl-debug}"
OT_APP_NAME=ot-cli-ftd
NRFUTIL_PROGRAM_OPTIONS="${NRFUTIL_PROGRAM_OPTIONS:-chip_erase_mode=ERASE_ALL,reset=RESET_SYSTEM}"
OBJCOPY="${OBJCOPY:-arm-none-eabi-objcopy}"

die()
{
    echo " ** ERROR: $1" >&2
    exit 1
}

require_cmd()
{
    command -v "$1" >/dev/null 2>&1 || die "Missing required command: $1"
}

resolve_firmware()
{
    local input="${1:-}"

    if [[ -n "${input}" ]]; then
        case "${input}" in
            *.hex) echo "${input}"; return ;;
            *.elf|*) echo "${input%.elf}.hex"; return ;;
        esac
    fi

    echo "${OT_SRCDIR}/${OT_CMAKE_BUILD_DIR}/bin/${OT_APP_NAME}.hex"
}

elf_to_hex()
{
    local elf="$1"
    local hex="$2"

    [[ -f "${elf}" ]] || die "ELF not found: ${elf} (run ./script/build-nrf54l15-cli-ftd-csl first)"
    require_cmd "${OBJCOPY}"
    "${OBJCOPY}" -O ihex "${elf}" "${hex}"
}

nrf54l15_jlink_serial()
{
    nrfutil device list --json 2>/dev/null | python3 -c "
import json, sys
for line in sys.stdin:
    try:
        o = json.loads(line)
    except json.JSONDecodeError:
        continue
    if o.get('type') != 'info':
        continue
    for d in o.get('data', {}).get('devices', []):
        if (d.get('devkit') or {}).get('boardVersion') == 'PCA10156':
            sn = d.get('serialNumber', '')
            print(sn.lstrip('0') or sn)
            sys.exit(0)
sys.exit(1)
" || die "No nRF54L15 DK (PCA10156) found. Connect one or set NRFUTIL_SERIAL_NUMBER."
}

main()
{
    local arg="${1:-}"
    local serial="${NRFUTIL_SERIAL_NUMBER:-}"
    local firmware_path
    local elf_path
    local hex_path

    require_cmd nrfutil

    if [[ -n "${arg}" && "${arg}" != *.hex && "${arg}" != *.elf && "${arg}" =~ ^[0-9]+$ ]]; then
        serial="${arg}"
        arg=""
    fi

    firmware_path="$(resolve_firmware "${arg}")"

    if [[ "${firmware_path}" == *.hex ]]; then
        hex_path="${firmware_path}"
        if [[ ! -f "${hex_path}" ]]; then
            elf_path="${hex_path%.hex}"
            elf_to_hex "${elf_path}" "${hex_path}"
        fi
    else
        elf_path="${firmware_path%.hex}"
        hex_path="${elf_path}.hex"
        elf_to_hex "${elf_path}" "${hex_path}"
    fi

    echo "Programming ${hex_path}"
    if [[ -z "${serial}" ]]; then
        serial="$(nrf54l15_jlink_serial)"
    fi
    echo "Device serial: ${serial} (nRF54L15 DK / PCA10156)"
    nrfutil device program \
        --firmware "${hex_path}" \
        --serial-number "${serial}" \
        --options "${NRFUTIL_PROGRAM_OPTIONS}"

    echo "Done."
}

main "$@"

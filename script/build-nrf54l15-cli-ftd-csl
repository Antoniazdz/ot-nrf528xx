# Build ot-cli-ftd for nRF54L15 with CSL receiver (UART CLI on DK).
#
# Usage (from repo root or any directory):
#   ./script/build-nrf54l15-cli-ftd-csl
#   ./script/build-nrf54l15-cli-ftd-csl -DOT_CSL_DEBUG=ON
#
# Output:
#   build-nrf54l15-cli-ftd-csl/bin/ot-cli-ftd

set -euo pipefail

OT_SRCDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
readonly OT_SRCDIR

NRF_PLATFORM=nrf54l15
OT_CMAKE_BUILD_DIR="${OT_CMAKE_BUILD_DIR:-build-nrf54l15-cli-ftd-csl}"
OT_NINJA_TARGET=ot-cli-ftd

OT_OPTIONS=(
    "-DCMAKE_BUILD_TYPE=MinSizeRel"
    "-DBUILD_TESTING=OFF"
    "-DOT_PLATFORM=external"
    "-DOT_SLAAC=ON"
    "-DOT_COMPILE_WARNING_AS_ERROR=ON"
    "-DNRF_PLATFORM=${NRF_PLATFORM}"
    "-DCMAKE_TOOLCHAIN_FILE=src/${NRF_PLATFORM}/arm-none-eabi.cmake"
    "-DOT_CSL_RECEIVER=ON"
    "-DOT_APP_RCP=OFF"
    "-DOT_APP_NCP=OFF"
    "-DOT_CSL_DEBUG=ON"
)

main()
{
    mkdir -p "${OT_SRCDIR}/${OT_CMAKE_BUILD_DIR}"
    cd "${OT_SRCDIR}/${OT_CMAKE_BUILD_DIR}"

    cmake -GNinja "${OT_OPTIONS[@]}" "$@" "${OT_SRCDIR}"
    ninja "${OT_NINJA_TARGET}"

    echo ""
    echo "Built: ${OT_SRCDIR}/${OT_CMAKE_BUILD_DIR}/bin/${OT_NINJA_TARGET}"
}

main "$@"
